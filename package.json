{
	"name": "infiniai-copilot",
	"publisher": "drewzhao",
	"displayName": "InfiniAI Provider for Copilot",
	"description": "An extension that InfiniAI API Providers into GitHub Copilot Chat",
	"icon": "assets/logo.png",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-model",
		"openai",
		"infiniai",
		"anthropic",
		"claude"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/drewzhao/infini-ai-copilot.git"
	},
	"version": "0.1.8",
	"engines": {
		"vscode": "^1.104.0"
	},
	"extensionDependencies": [
		"github.copilot-chat"
	],
	"categories": [
		"AI",
		"Chat"
	],
	"badges": [
		{
			"url": "https://img.shields.io/github/stars/drewzhao/infini-ai-copilot?style=social",
			"description": "Star infini-ai-copilot on Github",
			"href": "https://github.com/drewzhao/infini-ai-copilot"
		}
	],
	"bugs": {
		"url": "https://github.com/drewzhao/infini-ai-copilot/issues"
	},
	"license": "MIT",
	"enabledApiProposals": [
		"chatProvider",
		"languageModelThinkingPart"
	],
	"activationEvents": [
		"onStartupFinished",
		"onCommand:infiniai.setApikey"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "infiniai",
				"displayName": "InfiniAI",
				"managementCommand": "infiniai.setApikey"
			}
		],
		"commands": [
			{
				"command": "infiniai.setApikey",
				"title": "InfiniAI: Set InfiniAI Apikey"
			}
		],
		"configuration": {
			"title": "InfiniAI Compatible Copilot",
			"properties": {
				"infiniai.plan": {
					"type": "string",
					"enum": ["standard", "coding"],
					"default": "standard",
					"enumDescriptions": [
						"Pay-per-token billing. Uses the standard API endpoints.",
						"Coding Plan subscription. Uses /coding/ API endpoints and a separate API key."
					],
					"description": "Select the InfiniAI billing plan. The 'coding' plan uses a separate API key and different API endpoints."
				},
				"infiniai.baseUrl": {
					"type": "string",
					"default": "https://cloud.infini-ai.com/maas/v1",
					"description": "The base URL for the InfiniAI Compatible Inference API. Automatically adjusted when infiniai.plan is 'coding'."
				},
				"infiniai.anthropic.baseUrl": {
					"type": "string",
					"default": "https://cloud.infini-ai.com/maas",
					"description": "The base URL for the Anthropic Compatible Inference API. Automatically adjusted when infiniai.plan is 'coding'."
				},
				"infiniai.retry": {
					"type": "object",
					"default": {
						"enabled": true,
						"max_attempts": 3,
						"interval_ms": 1000
					},
					"properties": {
						"enabled": {
							"type": "boolean",
							"default": true,
							"description": "Enable retry mechanism for api errors. Default is true."
						},
						"max_attempts": {
							"type": "number",
							"default": 3,
							"minimum": 1,
							"description": "Maximum number of retry attempts. Default is 3."
						},
						"interval_ms": {
							"type": "number",
							"default": 1000,
							"minimum": 1,
							"description": "Interval between retry attempts in milliseconds. Default is 1000 (1 seconds)."
						},
						"status_codes": {
							"type": "array",
							"items": {
								"type": "number"
							},
							"description": "Additional HTTP status codes that will be merged. Default is [429, 500, 502, 503, 504]."
						}
					},
					"description": "Retry configuration for handling api errors like [429, 500, 502, 503, 504]."
				},
				"infiniai.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "Fixed delay in milliseconds between consecutive requests. Default is 0 (no delay)."
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"download-api": "dts dev && mv vscode.proposed.*.ts src",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"format": "prettier --write .",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && vscode-test",
		"build": "npx @vscode/vsce package --baseContentUrl https://raw.githubusercontent.com/drewzhao/infini-ai-copilot/refs/heads/infini-ai-copilot/ -o infiniai-copilot-$(node -p \"require('./package.json').version\").vsix"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"@vscode/dts": "^0.4.1",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.7.1",
		"eslint": "^9.13.0",
		"prettier": "^3.1.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
