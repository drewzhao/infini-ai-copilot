{
	"name": "infiniai-copilot",
	"publisher": "drewzhao",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"icon": "assets/logo.png",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-model",
		"openai",
		"infiniai",
		"anthropic",
		"claude"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/drewzhao/infini-ai-copilot.git"
	},
	"version": "0.4.0",
	"engines": {
		"vscode": "^1.117.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"badges": [
		{
			"url": "https://img.shields.io/github/stars/drewzhao/infini-ai-copilot?style=social",
			"description": "Star infini-ai-copilot on Github",
			"href": "https://github.com/drewzhao/infini-ai-copilot"
		}
	],
	"bugs": {
		"url": "https://github.com/drewzhao/infini-ai-copilot/issues"
	},
	"license": "MIT",
	"activationEvents": [
		"onCommand:infiniai.setApikey",
		"onCommand:infiniai.signOut",
		"onAuthenticationRequest:infiniai",
		"onView:infiniai.modelsView"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "infiniai",
				"displayName": "InfiniAI",
				"managementCommand": "infiniai.setApikey"
			}
		],
		"commands": [
			{
				"command": "infiniai.setApikey",
				"title": "%command.setApikey.title%"
			},
			{
				"command": "infiniai.signOut",
				"title": "%command.signOut.title%"
			},
			{
				"command": "infiniai.refreshModels",
				"title": "%command.refreshModels.title%",
				"category": "InfiniAI",
				"icon": "$(refresh)"
			},
			{
				"command": "infiniai.switchPlan",
				"title": "%command.switchPlan.title%",
				"category": "InfiniAI"
			},
			{
				"command": "infiniai.openSettings",
				"title": "%command.openSettings.title%",
				"category": "InfiniAI",
				"icon": "$(gear)"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "infiniai",
					"title": "InfiniAI",
					"icon": "assets/logo.png"
				}
			]
		},
		"views": {
			"infiniai": [
				{
					"id": "infiniai.modelsView",
					"name": "%view.models.name%"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "infiniai.refreshModels",
					"when": "view == infiniai.modelsView",
					"group": "navigation@1"
				},
				{
					"command": "infiniai.openSettings",
					"when": "view == infiniai.modelsView",
					"group": "navigation@2"
				}
			]
		},
		"chatParticipants": [
			{
				"id": "infiniai",
				"name": "infiniai",
				"fullName": "InfiniAI",
				"description": "%participant.description%",
				"commands": [
					{
						"name": "doctor",
						"description": "%participant.command.doctor.description%"
					},
					{
						"name": "models",
						"description": "%participant.command.models.description%"
					},
					{
						"name": "test",
						"description": "%participant.command.test.description%"
					}
				]
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"infiniai.plan": {
					"type": "string",
					"enum": [
						"standard",
						"coding"
					],
					"enumDescriptions": [
						"%configuration.plan.enum.standard%",
						"%configuration.plan.enum.coding%"
					],
					"description": "%configuration.plan.description%"
				},
				"infiniai.baseUrl": {
					"type": "string",
					"default": "https://cloud.infini-ai.com/maas/v1",
					"description": "%configuration.baseUrl.description%"
				},
				"infiniai.anthropic.baseUrl": {
					"type": "string",
					"default": "https://cloud.infini-ai.com/maas",
					"description": "%configuration.anthropic.baseUrl.description%"
				},
				"infiniai.coding.baseUrl": {
					"type": "string",
					"default": "https://cloud.infini-ai.com/maas/coding/v1",
					"description": "%configuration.coding.baseUrl.description%"
				},
				"infiniai.coding.anthropic.baseUrl": {
					"type": "string",
					"default": "https://cloud.infini-ai.com/maas/coding",
					"description": "%configuration.coding.anthropic.baseUrl.description%"
				},
				"infiniai.retry": {
					"type": "object",
					"default": {
						"enabled": true,
						"max_attempts": 3,
						"interval_ms": 1000
					},
					"properties": {
						"enabled": {
							"type": "boolean",
							"default": true,
							"description": "%configuration.retry.enabled.description%"
						},
						"max_attempts": {
							"type": "number",
							"default": 3,
							"minimum": 1,
							"description": "%configuration.retry.maxAttempts.description%"
						},
						"interval_ms": {
							"type": "number",
							"default": 1000,
							"minimum": 1,
							"description": "%configuration.retry.intervalMs.description%"
						},
						"status_codes": {
							"type": "array",
							"items": {
								"type": "number"
							},
							"description": "%configuration.retry.statusCodes.description%"
						}
					},
					"description": "%configuration.retry.description%"
				},
				"infiniai.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%configuration.delay.description%"
				},
				"infiniai.modelDiscoveryUrl": {
					"type": "string",
					"default": "",
					"description": "%configuration.modelDiscoveryUrl.description%"
				},
				"infiniai.modelCacheTtlMs": {
					"type": "number",
					"default": 300000,
					"minimum": 0,
					"description": "%configuration.modelCacheTtlMs.description%"
				},
				"infiniai.modelRoutes": {
					"type": "array",
					"default": [],
					"items": {
						"type": "object",
						"properties": {
							"pattern": {
								"type": "string"
							},
							"transport": {
								"type": "string",
								"enum": [
									"openai",
									"anthropic",
									"vertex"
								]
							},
							"baseUrl": {
								"type": "string"
							}
						},
						"required": [
							"pattern",
							"transport"
						]
					},
					"description": "%configuration.modelRoutes.description%"
				},
				"infiniai.imageInputModels": {
					"type": "array",
					"default": [],
					"items": {
						"type": "string"
					},
					"description": "%configuration.imageInputModels.description%"
				},
				"infiniai.disableImageInputModels": {
					"type": "array",
					"default": [],
					"items": {
						"type": "string"
					},
					"description": "%configuration.disableImageInputModels.description%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint \"src/**/*.ts\"",
		"format": "prettier --write .",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && mocha \"out/**/*.test.js\"",
		"build": "npx @vscode/vsce package --baseContentUrl https://raw.githubusercontent.com/drewzhao/infini-ai-copilot/refs/heads/infini-ai-copilot/ -o infiniai-copilot-$(node -p \"require('./package.json').version\").vsix"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"@types/vscode": "^1.116.0",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.7.1",
		"eslint": "^9.13.0",
		"mocha": "^11.7.5",
		"prettier": "^3.1.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
